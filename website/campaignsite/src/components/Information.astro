---
import { Image } from "astro:assets";
import { lazy } from "astro:schema";

import AntwerpLogo from "../assets/AntwerpLogo.png";
---

<section class="information">
    <svg
        class="featured__top"
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="auto"
        viewBox="0 0 1440 394"
        fill="none"
    >
        <path
            d="M70.2252 290.859H-0.319092V0H1440.95V82.4825H1379.09V187.756H1440.95V393.962H1308.55V187.756H1000.32V151.941H826.677V82.4825H655.2V119.383H621.556V82.4825H516.282V187.756H344.805V82.4825H173.328V187.756H70.2252V290.859Z"
            fill="#1E1E1E"></path>
    </svg>
    <div class="container information__container">
        <h2 class="information__title">
            <span class="information__title--highlight">Discover</span> Antwerp!
        </h2>
        <p class="information__subtitle">
            Your POV doesn’t stop here. Discover <span class="highlight__bold"
                >new places</span
            >, <span class="highlight__bold">different</span>
            <span class="highlight__bold">perspectives</span> and the Antwerp you
            didn’t expect.
        </p>
    </div>
    <div class="antwerplogo">
        <Image
            class="antwerplogo__img"
            src={AntwerpLogo}
            alt="logo antwerp"
            width="62"
            height="41"
        />
        <svg
            class="antwerplogo__bg"
            xmlns="http://www.w3.org/2000/svg"
            width="120"
            height="124"
            viewBox="0 0 120 124"
            fill="none"
        >
            <path
                d="M116.129 54.25H112.258H108.387V50.375H104.516H100.645V46.5H96.7742V42.625H100.645V38.75H104.516V34.875V31H108.387V27.125V23.25H104.516V27.125H100.645H96.7742V31H92.9032H89.0323V27.125H85.1613V23.25H81.2903V19.375V15.5V11.625V7.75V3.875H77.4194V7.75H73.5484V11.625H69.6774V15.5H65.8064V19.375H61.9355H58.0645V15.5H54.1935V11.625H50.3226V7.75H46.4516V3.875V0H42.5806V3.875V7.75V11.625V15.5V19.375H38.7097V23.25H34.8387V27.125H30.9677H27.0968V23.25H23.2258H19.3548V27.125V31H23.2258V34.875V38.75V42.625H19.3548V46.5H15.4839H11.6129V50.375H7.74194H3.87097H0V54.25H3.87097V58.125H7.74194H11.6129V62H15.4839V65.875V69.75V73.625H11.6129V77.5H7.74194V81.375H3.87097V85.25H7.74194H11.6129H15.4839H19.3548V89.125H23.2258V93H27.0968V96.875V100.75H23.2258V104.625V108.5H27.0968H30.9677V104.625H34.8387H38.7097V100.75H42.5806V104.625H46.4516V108.5H50.3226V112.375V116.25H54.1935V120.125V124H58.0645V120.125V116.25H61.9355V112.375H65.8064V108.5H69.6774V104.625H73.5484H77.4194V108.5H81.2903V112.375H85.1613V116.25H89.0323V112.375V108.5V104.625H85.1613V100.75V96.875H89.0323V93H92.9032H96.7742H100.645H104.516H108.387H112.258V89.125H108.387V85.25H104.516V81.375H100.645V77.5V73.625V69.75H104.516V65.875H108.387H112.258V62H116.129V58.125H120V54.25H116.129Z"
                fill="#BD293A"></path>
        </svg>
    </div>
    <a class="information__button" href="">Visit Antwerp →</a>
</section>
<svg
    class="featured__bottom"
    xmlns="http://www.w3.org/2000/svg"
    width="100%"
    height="auto"
    viewBox="0 0 1440 306"
    fill="none"
>
    <path d="M70.3044 0H-0.358704V103.722H70.3044V0Z" fill="#1E1E1E"></path>
    <path
        d="M-0.358704 297.376H175.396V203.676H345.604V297.376H517.53V242.359H687.738V274.166H825.279V297.376H894.049V274.166H929.294V207.114H1205.24V102.239H1440.78V305.972H-0.358704V297.376ZM1308.71 207.114V298.907H1410.45V207.114H1308.71Z"
