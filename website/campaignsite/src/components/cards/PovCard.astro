---
import { Image } from "astro:assets";

import POV1 from "../../assets/POVS/fashionista.png";
import POV2 from "../../assets/POVS/mainCharacter.png";
import POV3 from "../../assets/POVS/RaverPOV.png";
---

<div class="pov__cards">
    <article class="pov__card">
        <ul class="pov__content">
            <li><h3 class="pov__title">Fashionista</h3></li>
            <li class="pov__center">
                <Image class="pov__image" src={POV1} alt="hey" />
            </li>
            <li class="pov__bottom">
                <p class="pov__text">POV</p><p class="pov__text">
                    Your bag has more plans than you.
                </p>
            </li>
        </ul>
    </article>
    <article class="pov__card">
        <ul class="pov__content">
            <li><h3 class="pov__title">Main Character</h3></li>
            <li class="pov__center">
                <Image class="pov__image" src={POV2} alt="hey" />
            </li>
            <li class="pov__bottom">
                <p class="pov__text">POV</p><p class="pov__text">
                    You’re not over confident, you’re just geographically
                    convinced.
                </p>
            </li>
        </ul>
    </article>
    <article class="pov__card">
        <ul class="pov__content">
            <li><h3 class="pov__title">Raver</h3></li>
            <li class="pov__center">
                <Image class="pov__image" src={POV3} alt="hey" />
            </li>
            <li class="pov__bottom">
                <p class="pov__text">POV</p><p class="pov__text">
                    You packed sunglasses for the morning after.
                </p>
            </li>
        </ul>
    </article>
</div>
