---
import { Image } from "astro:assets";
import Image1Fashion from "../../assets/routes/fashionista/picture-1.png";

const fashionistaLocations = [
    "Graanmarkt",
    "Korte gasthuisstraat",
    "Lombardenvest",
    "Kammenstraat",
    "MoMu",
    "Nationalestraat",
    "Kloosterstraat",
];

const mcLocations = [
    "Ampere",
    "Mechelseplein",
    "Kavka oudaan",
    "Frituur n1",
    "Linkeroever sunrise",
    "Club vaag",
    "Park spoor noord",
];

const raverLocations = [
    "Central station",
    "Trade fair",
    "Stadsfeestzaal",
    "Brabo fountain",
    "Vlaeykensgang",
    "Steenplijn",
    "Vlaeykensgang",
];

const colorCycleLocationIndex = [
    "location__index--blue",
    "location__index--pink",
    "location__index--green",
    "location__index--white",
    "location__index--blue",
    "location__index--pink",
    "location__index--green",
];

const colorCycleStopImages = [
    "stop__image--blue",
    "stop__image--pink",
    "stop__image--green",
    "stop__image--white",
    "stop__image--blue",
    "stop__image--pink",
    "stop__image--green",
];

const fahsionistaImages = import.meta.glob(
    "../../assets/routes/fashionista/*.{png,jpg,jpeg,webp}",
    { eager: true },
);

const mcImages = import.meta.glob(
    "../../assets/routes/mc/*.{png,jpg,jpeg,webp}",
    {
        eager: true,
    },
);

const raverImages = import.meta.glob(
    "../../assets/routes/raver/*.{png,jpg,jpeg,webp}",
    { eager: true },
);

const fashionistaImageCollection = Object.entries(fahsionistaImages)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, mod]) => mod.default);

const mcImageCollection = Object.entries(mcImages)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, mod]) => mod.default);

const raverImageCollection = Object.entries(raverImages)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, mod]) => mod.default);
---

<article class="route__stops">
    <h3 class="stops__title">The route stops</h3>
    <div class="stops__collection">
        <ul class="stops__list pov__route--active" id="fashionista">
            {
                fashionistaImageCollection.map((fashionistaImage, index) => {
                    return (
                        <li>
                            <ul>
                                <li>
                                    <Image
                                        class={`stop__image ${colorCycleStopImages[index]}`}
                                        src={fashionistaImage}
                                        alt="fashionistaImage"
                                    />
                                </li>
                                <li class="route__stop">
                                    <p
                                        class={`location__index ${colorCycleLocationIndex[index]}`}
                                    >
                                        {index + 1}.
                                    </p>
                                    <p class="location__text">
                                        {fashionistaLocations[index]}
                                    </p>
                                </li>
                            </ul>
                        </li>
                    );
                })
            }
        </ul>
        <ul class="stops__list" id="mc">
            {
                mcImageCollection.map((mcImage, index) => {
                    return (
                        <li>
                            <ul>
                                <li>
                                    <Image
                                        class={`stop__image ${colorCycleStopImages[index]}`}
                                        src={mcImage}
                                        alt="mcImage"
                                    />
                                </li>
                                <li class="route__stop">
                                    <p
                                        class={`location__index ${colorCycleLocationIndex[index]}`}
                                    >
                                        {index + 1}.
                                    </p>
                                    <p class="location__text">
                                        {mcLocations[index]}
                                    </p>
                                </li>
                            </ul>
                        </li>
                    );
                })
            }
        </ul>
        <ul class="stops__list" id="raver">
            {
                raverImageCollection.map((raverImage, index) => {
                    return (
                        <li>
                            <ul>
                                <li>
                                    <Image
                                        class={`stop__image ${colorCycleStopImages[index]}`}
                                        src={raverImage}
                                        alt="raverImage"
                                    />
                                </li>
                                <li class="route__stop">
                                    <p
                                        class={`location__index ${colorCycleLocationIndex[index]}`}
                                    >
                                        {index + 1}.
                                    </p>
                                    <p class="location__text">
                                        {raverLocations[index]}
                                    </p>
                                </li>
                            </ul>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</article>
