---
import { Image } from "astro:assets"

import Hero from "../../assets/routes/routes-hero.png"

---

<section class="hero__routes">
    <div class="hero__top">
        <div class="routes__content">
            <h1 class="hero__title">Routes</h1>
            <p class="hero__subtitle">of the POVs</p>
            <p class="routes__subtext">
                These point of views of stereotypes are only the start. Download
                routes that show you Antwerp behind the clichés.
            </p>
        </div>
        <Image class="hero__image" src={Hero} alt="Hero image" />
    </div>
    <div class="hero__content">

    </div>
</section>
