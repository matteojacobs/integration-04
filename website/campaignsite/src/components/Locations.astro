---
const locations = [
    { city: "Amsterdam", place: "NDSM Wharf" },
    { city: "Leuven", place: "Oude Markt" },
    { city: "Rotterdam", place: "Schouwburgplein" },
    { city: "Bruges", place: "Markt" },
    { city: "Antwerp", place: "Groenplaats" },
];
---

<section class="locations">
    <h2 class="locations__title">Where we are located</h2>
    <ul class="locations__list">
        {
            locations.map((location) => (
                <li>
                    <ul class="location">
                        <li>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="54"
                                height="75"
                                viewBox="0 0 54 75"
                                fill="none"
                            >
                                <path
                                    d="M50.625 16.875V10.125H47.25V6.75H43.875V3.375H37.125V0H16.875V3.375H10.125V6.75H6.75V10.125H3.375V16.875H0V37.125H3.375V43.875H6.75V47.25H10.125V54H13.5V57.375H16.875V64.125H20.25V67.5H23.625V74.25H30.375V67.5H33.75V64.125H37.125V57.375H40.5V54H43.875V47.25H47.25V43.875H50.625V37.125H54V16.875H50.625ZM33.75 33.75H30.375V37.125H23.625V33.75H20.25V30.375H16.875V23.625H20.25V20.25H23.625V16.875H30.375V20.25H33.75V23.625H37.125V30.375H33.75V33.75Z"
                                    fill="#E37ED4"
                                />
                            </svg>
                        </li>
                        <div class="location__text">
                            <li class="location__city">{location.city}</li>
                            <li class="location__place">{location.place}</li>
                        </div>
                    </ul>
                </li>
            ))
        }
    </ul>
    <svg
        class="locations__bottom"
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="AUTO"
        viewBox="0 0 1443 89"
        fill="none"
    >
        <path
            d="M1442.7 -0.000488281V89H0V36.3431H96.4395V0.359558H160.372V36H284.873V0.359558H410.215V35.9994H538.08V0.359558H602.854V35.9994H1042.81V-0.000488281H1358.13V35.9994H1422.48V-0.000488281H1442.7Z"
            fill="#1E1E1E"></path>
    </svg>
</section>
