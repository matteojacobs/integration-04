---
import FeatureCard from "./cards/FeatureCard.astro";
import Information from "./Information.astro";
import RecentSubmissions from "../components/FeatureCardRecents";

import { supabase } from "../db/supabase";

const { data } = await supabase
    .from("photo_submissions")
    .select("*")
    .eq("feature_me", true)
    .order("created_at", { ascending: false })
    .limit(4);
---

<section class="featured" id="featured">
    <div class="featured__pt1">
        <div class="featured__container">
            <div class="featured__top">
                <h2 class="featured__title">
                    <span class="featured__title--highlight">Featured</span> POVs
                </h2>
                <p class="featured__subtitle">
                    Want to be featured on the <span class="highlight__bold">website</span>? Capture your POV at the
                    installation and choose <span class="highlight__bold">“feature me”</span> after scanning your QR
                </p>
            </div>
            <ul class="featured__submissions">
                <RecentSubmissions client:load initialData={data ?? []} />
            </ul>
        </div>
    </div>
</section>
<Information />
