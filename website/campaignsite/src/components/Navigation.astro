---
const currentPath = Astro.url.pathname;
---

<ul class="nav__list">
    <li
        class={`nav__item ${currentPath === "/integration-04/" ? "nav__item--active" : ""}`}
    >
        <a
            class={`nav__link ${currentPath === "/integration-04/" ? "nav__link--active" : ""}`}
            href=`${import.meta.env.BASE_URL}`
        >
            Home
        </a>
    </li>

    <li
        class={`nav__item ${currentPath === "/integration-04/routes/" ? "nav__item--active" : ""}`}
    >
        <a
            class={`nav__link ${currentPath === "/integration-04/routes/" ? "nav__link--active" : ""}`}
            href=`${import.meta.env.BASE_URL}/routes/`
        >
            Routes
        </a>
    </li>
</ul>
