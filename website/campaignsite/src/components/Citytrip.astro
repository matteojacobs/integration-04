---
import { Image } from "astro:assets";

import Installation from "../assets/installation.png";
---

<section class="citytrip">
    <div class="container citytrip__container">
        <div class="citytrip__content">
            <h2 class="citytrip__title">
                From screen to <span class="citytrip__title--highlight"
                    >citytrip</span
                >
            </h2>
            <p class="citytrip__text">
                Across Belgium and neighboring countries we placed an
                installation that allows you to experience the point of views.
            </p>
            <h3 class="citytrip__subtitle">How it works</h3>
            <p class="citytrip__text">
                Use the kiosk to customize the POV: how do you see Antwerp? Take
                a photo or get the route behind it. Every interaction starts as
                a joke, but leads to a real way to discover Antwerp.
            </p>
            <ul class="citytrip__steps">
                <li class="citytrip__step">
                    <ul class="step__content">
                        <li class="step__icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="44"
                                height="44"
                                viewBox="0 0 44 44"
                                fill="none"
                            >
                                <path
                                    d="M42 38V36H40V34H38V32H36V30H32V28H34V24H36V12H34V8H32V6H30V4H28V2H24V0H12V2H8V4H6V6H4V8H2V12H0V24H2V28H4V30H6V32H8V34H12V36H24V34H28V32H30V36H32V38H34V40H36V42H38V44H42V42H44V38H42ZM22 28V30H14V28H10V26H8V22H6V14H8V10H10V8H14V6H22V8H26V10H28V14H30V22H28V26H26V28H22Z"
                                    fill="#545CAB"></path>
                            </svg>
                        </li>
                        <li class="citytrip__text step__text">
                            find installation
                        </li>
                    </ul>
                </li>
                <li class="citytrip__step">
                    <ul class="step__content">
                        <li class="step__icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="71"
                                height="71"
                                viewBox="0 0 71 71"
                                fill="none"
                            >
                                <path
                                    d="M68.0417 14.7916V17.75H62.125V20.7083H59.1667V26.625H56.2083V20.7083H53.25V17.75H47.3333V14.7916H53.25V11.8333H56.2083V5.91663H59.1667V11.8333H62.125V14.7916H68.0417Z"
                                    fill="#545CAB"></path>
                                <path
                                    d="M68.0417 53.25V56.2083H62.125V59.1667H59.1667V65.0833H56.2083V59.1667H53.25V56.2083H47.3333V53.25H53.25V50.2917H56.2083V44.375H59.1667V50.2917H62.125V53.25H68.0417Z"
                                    fill="#545CAB"></path>
                                <path
                                    d="M44.375 32.5417V29.5834H38.4583V26.625H35.5V23.6667H32.5417V17.75H29.5833V11.8334H23.6667V17.75H20.7083V23.6667H17.75V26.625H14.7917V29.5834H8.87501V32.5417H2.95834V38.4584H8.87501V41.4167H14.7917V44.375H17.75V47.3334H20.7083V53.25H23.6667V59.1667H29.5833V53.25H32.5417V47.3334H35.5V44.375H38.4583V41.4167H44.375V38.4584H50.2917V32.5417H44.375ZM35.5 38.4584V41.4167H32.5417V44.375H29.5833V50.2917H23.6667V44.375H20.7083V41.4167H17.75V38.4584H11.8333V32.5417H17.75V29.5834H20.7083V26.625H23.6667V20.7084H29.5833V26.625H32.5417V29.5834H35.5V32.5417H41.4167V38.4584H35.5Z"
                                    fill="#545CAB"></path>
                            </svg>
                        </li>
                        <li class="citytrip__text step__text">customize</li>
                    </ul>
                </li>
                <li class="citytrip__step">
                    <ul class="step__content">
                        <li>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="54"
                                height="54"
                                viewBox="0 0 54 54"
                                fill="none"
                            >
                                <path
                                    d="M49.5 15.75V13.5H47.25V11.25H38.25V6.75H36V4.5H18V6.75H15.75V11.25H6.75V13.5H4.5V15.75H2.25V45H4.5V47.25H6.75V49.5H47.25V47.25H49.5V45H51.75V15.75H49.5ZM47.25 42.75H45V45H9V42.75H6.75V18H9V15.75H18V13.5H20.25V9H33.75V13.5H36V15.75H45V18H47.25V42.75Z"
                                    fill="#545CAB"></path>
                                <path
                                    d="M36 24.75V33.75H33.75V36H31.5V38.25H22.5V36H20.25V33.75H18V24.75H20.25V22.5H22.5V20.25H31.5V22.5H33.75V24.75H36Z"
                                    fill="#545CAB"></path>
                                <path
                                    d="M15.75 18H11.25V22.5H15.75V18Z"
                                    fill="#545CAB"></path>
                            </svg>
                        </li>
                        <li class="citytrip__text step__text">
                            capture the moment
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
        <Image
            class="citytrip__installation"
            src={Installation}
            alt="Installationscreen"
        />
    </div>
</section>
