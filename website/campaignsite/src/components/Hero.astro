---
import { Image } from "astro:assets";
import HeroImg1 from "../assets/hero-home/hero-img-1.png";
import HeroImg2 from "../assets/hero-home/hero-img2.png";
import HeroImg3 from "../assets/hero-home/hero-img-3.png";

// const heroImages = [HeroImg1, HeroImg2, HeroImg3];

const imageModules = import.meta.glob(
    "../assets/hero-home/*.{png,jpg,jpeg,webp}",
    { eager: true },
);

const heroImages = Object.entries(imageModules)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, mod]) => mod.default);
---

<section class="hero">
    <h1 class="hero__title">AntwerPOV</h1>
    <p class="hero__subtitle">View Antwerp through others</p>
    <div class="hero__content">
        <ul class="hero__images">
            {
                heroImages.map((heroImage) => {
                    return (
                        <li>
                            <Image src={heroImage} alt="" />
                        </li>
                    );
                })
            }
        </ul>
    </div>
</section>
